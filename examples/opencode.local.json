{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "resolve": {
      "type": "local",
      "command": [
        "C:\\path\\to\\resolve-mcp-kit\\.venv\\Scripts\\python.exe",
        "C:\\path\\to\\resolve-mcp-kit\\resolve_mcp_server.py"
      ],
      "environment": {
        "RESOLVE_MCP_TRANSPORT": "stdio",
        "RESOLVE_MCP_ALLOW_WRITE": "1"
      },
      "enabled": true,
      "timeout": 60000
    }
  }
}
